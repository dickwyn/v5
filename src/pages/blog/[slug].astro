---
import { getCollection, render } from 'astro:content';
import getReadingTime from 'reading-time';
import { ArrowUp } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import CodeCopyButton from '../../components/CodeCopyButton.astro';
import CopyMarkdown from '../../components/CopyMarkdown.astro';
import PostTags from '../../components/PostTags.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { formatDate } from '../../utils';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => import.meta.env.DEV || !post.data.draft);
	const publishedPosts = posts
		.filter((p) => !p.data.draft)
		.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

	return posts.map((post) => {
		const idx = publishedPosts.findIndex((p) => p.data.slug === post.data.slug);
		const newerPost = idx > 0 ? publishedPosts[idx - 1] : null;
		const olderPost = idx >= 0 && idx < publishedPosts.length - 1 ? publishedPosts[idx + 1] : null;

		return {
			params: { slug: post.data.slug },
			props: {
				post,
				newerPost: newerPost ? { slug: newerPost.data.slug, title: newerPost.data.title } : null,
				olderPost: olderPost ? { slug: olderPost.data.slug, title: olderPost.data.title } : null,
			},
		};
	});
}

const { post, newerPost, olderPost } = Astro.props;
const { Content, headings } = await render(post);
const baseUrl = 'https://dickwyn.com';
const ogImage = post.data.image
	? post.data.image.startsWith('http')
		? post.data.image
		: `${baseUrl}${post.data.image}`
	: undefined;

const tocEntries = headings.filter((heading) => heading.depth <= 3);
const minTocDepth = tocEntries.length > 0 ? Math.min(...tocEntries.map((entry) => entry.depth)) : 0;
const toc = tocEntries.map((entry) => ({
	...entry,
	depth: Math.min(entry.depth - minTocDepth + 2, 3),
}));
const readTime = getReadingTime(post.body ?? '').text;
---

<Base title={post.data.title} description={post.data.description} ogImage={ogImage}>
	<div
		id="reading-progress"
		class="fixed top-0 left-0 z-50 h-0.5 w-0 bg-brand transition-[width] duration-150 ease-out"
		role="progressbar"
		aria-hidden="true"
	>
	</div>
	<article id="post-article">
		<header class="mb-10 border-b border-neutral-200 pb-6 dark:border-neutral-800">
			<h1 class="font-serif text-3xl leading-[1.15] font-semibold tracking-tight text-balance sm:text-4xl">
				{post.data.title}
			</h1>
			{post.data.subtitle && (
				<p class="mt-3 font-serif text-lg leading-snug text-balance text-neutral-600 italic dark:text-neutral-400">
					{post.data.subtitle}
				</p>
			)}
			<div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-neutral-600 dark:text-neutral-400">
				<time datetime={post.data.date}>{formatDate(post.data.date)}</time>
				<span class="text-neutral-400 dark:text-neutral-600" aria-hidden="true">·</span>
				<span>{readTime}</span>
				<span class="text-neutral-400 dark:text-neutral-600" aria-hidden="true">·</span>
				<CopyMarkdown slug={post.data.slug} />
			</div>
			<PostTags tags={post.data.tags} />
		</header>

		<div class="relative">
			{
				toc.length > 0 && (
					<aside
						class="hidden min-[1180px]:absolute min-[1180px]:top-0 min-[1180px]:left-[calc(100%+3rem)] min-[1180px]:block min-[1180px]:h-full min-[1180px]:w-52"
					>
						<TableOfContents headings={toc} variant="desktop" />
					</aside>
				)
			}
			<div class="min-[1180px]:hidden">
				<TableOfContents headings={toc} variant="mobile" />
			</div>
			<div class:list={['blog', { 'has-drop-cap': post.data.dropCap }]}>
				<Content />
			</div>
		</div>

		{
			(newerPost || olderPost) && (
				<nav class="mt-16 grid grid-cols-1 gap-6 border-t border-neutral-200 pt-6 sm:grid-cols-2 dark:border-neutral-800">
					<div>
						{newerPost && (
							<>
								<span class="mb-1 block text-xs tracking-widest text-neutral-500 uppercase dark:text-neutral-400">
									Newer
								</span>
								<a href={`/blog/${newerPost.slug}`}>{newerPost.title}</a>
							</>
						)}
					</div>
					<div class="sm:text-right">
						{olderPost && (
							<>
								<span class="mb-1 block text-xs tracking-widest text-neutral-500 uppercase dark:text-neutral-400">
									Older
								</span>
								<a href={`/blog/${olderPost.slug}`}>{olderPost.title}</a>
							</>
						)}
					</div>
				</nav>
			)
		}
	</article>
	<button
		type="button"
		id="back-to-top"
		class="pointer-events-none fixed right-4 bottom-4 z-50 inline-flex h-10 w-10 -translate-y-2 items-center justify-center rounded-full border border-neutral-200 bg-white text-neutral-600 opacity-0 shadow-sm transition-all hover:text-brand sm:right-8 sm:bottom-8 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400"
		aria-label="Back to top"
		tabindex="-1"
		inert
	>
		<ArrowUp size={18} aria-hidden="true" />
	</button>
	<CodeCopyButton />
	<script>
		const article = document.getElementById('post-article');
		const progressBar = document.getElementById('reading-progress');
		const backToTop = document.getElementById('back-to-top');

		const updateOnScroll = () => {
			if (article && progressBar) {
				const articleTop = article.offsetTop;
				const scrollable = Math.max(article.offsetHeight - window.innerHeight, 1);
				const scrolled = Math.min(Math.max(window.scrollY - articleTop, 0), scrollable);

				progressBar.style.width = `${(scrolled / scrollable) * 100}%`;
			}

			if (backToTop) {
				const visible = window.scrollY > 600;

				backToTop.classList.toggle('opacity-0', !visible);
				backToTop.classList.toggle('pointer-events-none', !visible);
				backToTop.classList.toggle('-translate-y-2', !visible);
				backToTop.toggleAttribute('inert', !visible);
				backToTop.tabIndex = visible ? 0 : -1;
			}
		};

		backToTop?.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});

		updateOnScroll();
		addEventListener('scroll', updateOnScroll, { passive: true });
		addEventListener('resize', updateOnScroll, { passive: true });
	</script>
</Base>
