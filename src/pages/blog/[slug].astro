---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CopyMarkdown from '../../components/CopyMarkdown.astro';
import PostTags from '../../components/PostTags.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { buildToc, formatDate, readingTime } from '../../utils';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => import.meta.env.DEV || !post.data.draft);
	const publishedPosts = posts
		.filter((p) => !p.data.draft)
		.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

	return posts.map((post) => {
		const idx = publishedPosts.findIndex((p) => p.data.slug === post.data.slug);
		const newerPost = idx > 0 ? publishedPosts[idx - 1] : null;
		const olderPost = idx >= 0 && idx < publishedPosts.length - 1 ? publishedPosts[idx + 1] : null;

		return {
			params: { slug: post.data.slug },
			props: {
				post,
				newerPost: newerPost ? { slug: newerPost.data.slug, title: newerPost.data.title } : null,
				olderPost: olderPost ? { slug: olderPost.data.slug, title: olderPost.data.title } : null,
			},
		};
	});
}

const { post, newerPost, olderPost } = Astro.props;
const { Content, headings } = await render(post);
const baseUrl = 'https://dickwyn.com';
const ogImage = post.data.image
	? post.data.image.startsWith('http')
		? post.data.image
		: `${baseUrl}${post.data.image}`
	: undefined;

const toc = buildToc(headings);
const readTime = readingTime(post.body ?? '');
---

<Base title={post.data.title} description={post.data.description} ogImage={ogImage}>
	<article>
		<header class="post-header">
			<h1 class="post-title">{post.data.title}</h1>
			{post.data.subtitle && <p class="post-subtitle">{post.data.subtitle}</p>}
			<div class="post-meta">
				<time datetime={post.data.date}>{formatDate(post.data.date)}</time>
				<span class="post-meta-dot" aria-hidden="true">·</span>
				<span>{readTime}</span>
				<span class="post-meta-dot" aria-hidden="true">·</span>
				<CopyMarkdown slug={post.data.slug} />
			</div>
			<PostTags tags={post.data.tags} />
		</header>

		<div class="post-layout">
			{
				toc.length > 0 && (
					<aside class="post-sidebar">
						<TableOfContents headings={toc} />
					</aside>
				)
			}
			<div class:list={['blog', { 'has-drop-cap': post.data.dropCap }]}>
				<Content />
			</div>
		</div>

		{
			(newerPost || olderPost) && (
				<nav class="post-pager">
					<div>
						{newerPost && (
							<>
								<span class="post-pager-label">Newer</span>
								<a href={`/blog/${newerPost.slug}`}>{newerPost.title}</a>
							</>
						)}
					</div>
					<div class="post-pager-older">
						{olderPost && (
							<>
								<span class="post-pager-label">Older</span>
								<a href={`/blog/${olderPost.slug}`}>{olderPost.title}</a>
							</>
						)}
					</div>
				</nav>
			)
		}
	</article>
</Base>
