---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate } from '../utils';

const latestPost = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())[0];
---

<Base
	description="I'm Dickwyn, a software engineer building fraud protection at Microsoft. Malaysian, living in the U.S."
>
	<div class="home">
		<section class="hero" aria-labelledby="intro-title">
			<div class="hero-copy">
				<p class="eyebrow"><span class="status-dot"></span> software engineer · curious by default</p>
				<h1 id="intro-title">hi, i'm <span>Dickwyn</span></h1>
				<p class="intro">
					I build secure, thoughtful web experiences at <a
						href="https://microsoft.com"
						target="_blank"
						rel="noopener noreferrer">Microsoft</a
					>, where I work on fraud protection for the company's digital ecosystem.
				</p>
				<div class="hero-links">
					<a class="primary-link" href="/blog">Read my writing <span aria-hidden="true">↗</span></a>
					<a class="text-link" href="/resume">Résumé <span aria-hidden="true">↗</span></a>
				</div>
			</div>

			<figure class="portrait">
				<img
					src="/images/dick-wyn-yong.jpg"
					alt="Dickwyn at Arizona State University"
					width="947"
					height="960"
					fetchpriority="high"
				/>
				<figcaption><span>Tempe, Arizona</span><span>2019</span></figcaption>
			</figure>

			<div class="hero-note" aria-hidden="true">
				<span>01 / 03</span>
				<span class="note-line"></span>
				<span>somewhere between code &amp; a long run</span>
			</div>
		</section>

		<section class="about" aria-label="A little about me">
			<div class="about-heading">
				<p class="eyebrow">a little about me</p>
				<h2>Rooted in one place.<br />Always curious about the next.</h2>
			</div>
			<div class="about-copy">
				<p>
					Born and raised in <a
						href="https://www.malaysia.travel"
						target="_blank"
						rel="noopener noreferrer">Malaysia</a
					>, I made my way to Arizona State University for a computer science degree. These days,
					I’m in the U.S. building things for work and finding reasons to get outside after.
				</p>
				<p>
					Currently training for a full marathon. Usually thinking about Formula 1, airplanes,
					photography, travel, or where to eat next.
				</p>
				<a class="text-link" href="/things">A few things I’m into <span aria-hidden="true">↗</span></a>
			</div>
		</section>

		{
			latestPost && (
				<section class="latest" aria-labelledby="latest-title">
					<div class="latest-label">
						<p class="eyebrow">latest writing</p>
						<time datetime={latestPost.data.date}>{formatDate(latestPost.data.date)}</time>
					</div>
					<div class="latest-copy">
						<h2 id="latest-title">
							<a href={`/blog/${latestPost.data.slug}`}>{latestPost.data.title}</a>
						</h2>
						<p>{latestPost.data.description}</p>
					</div>
					<a class="latest-arrow" href={`/blog/${latestPost.data.slug}`} aria-label="Read latest post">
						<span aria-hidden="true">↗</span>
					</a>
				</section>
			)
		}
	</div>
</Base>

<style>
	.home {
		--paper: #f7f3ed;
		--ink: #29251f;
		--muted: #716b62;
		--line: #ded7cc;
		--accent: #b94f35;
		--accent-deep: #8d3926;
		color: var(--ink);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.88fr);
		align-items: center;
		gap: 1.5rem;
		padding: 2rem 0 1.25rem;
	}

	.hero-copy {
		animation: arrive 700ms both;
	}

	.eyebrow {
		margin: 0;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.hero-copy > .eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.status-dot {
		width: 0.4rem;
		height: 0.4rem;
		flex: 0 0 auto;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent);
	}

	.hero h1 {
		margin: 1.5rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(2.7rem, 8vw, 4.25rem);
		font-weight: 500;
		letter-spacing: -0.075em;
		line-height: 0.96;
	}

	.hero h1 span {
		display: block;
		color: var(--accent);
		font-style: italic;
	}

	.intro,
	.about-copy p {
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.8;
	}

	.intro {
		margin: 1.25rem 0 1.5rem;
	}

	.intro a,
	.about-copy a:not(.text-link) {
		color: var(--ink);
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
	}

	.primary-link,
	.text-link {
		font-size: 0.75rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.primary-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.75rem 0.9rem;
		border-radius: 0.2rem;
		background: var(--accent);
		color: #fff;
	}

	.primary-link:hover {
		background: var(--accent-deep);
		color: #fff;
	}

	.primary-link span,
	.text-link span {
		font-size: 1rem;
		transition: transform 160ms ease;
	}

	.primary-link:hover span,
	.text-link:hover span,
	.latest-arrow:hover span {
		transform: translate(2px, -2px);
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--ink);
	}

	.text-link:hover {
		color: var(--accent);
	}

	.portrait {
		position: relative;
		margin: 0;
		padding: 0.55rem 0.55rem 2.2rem;
		background: var(--paper);
		box-shadow: 0.7rem 0.8rem 0 -0.3rem color-mix(in srgb, var(--accent) 22%, transparent);
		animation: arrive 700ms 120ms both;
		transform: rotate(1.5deg);
	}

	.portrait img {
		display: block;
		width: 100%;
		aspect-ratio: 0.88;
		object-fit: cover;
		object-position: center 38%;
		filter: saturate(0.82);
	}

	.portrait figcaption {
		position: absolute;
		right: 0.65rem;
		bottom: 0.68rem;
		left: 0.65rem;
		display: flex;
		justify-content: space-between;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.55rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.hero-note {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-top: 0.25rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.55rem;
		letter-spacing: 0.045em;
		text-transform: uppercase;
	}

	.note-line {
		width: 2.5rem;
		height: 1px;
		background: var(--line);
	}

	.about {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 1.5rem;
		padding: 2rem 0;
		border-top: 1px solid var(--line);
	}

	.about-heading h2 {
		margin: 0.8rem 0 0;
		font-family: var(--font-serif);
		font-size: 1.5rem;
		font-weight: 500;
		letter-spacing: -0.045em;
		line-height: 1.15;
	}

	.about-copy p {
		margin: 0 0 0.75rem;
		font-size: 0.8125rem;
	}

	.about-copy .text-link {
		margin-top: 0.2rem;
	}

	.latest {
		display: grid;
		grid-template-columns: 7rem 1fr auto;
		align-items: start;
		gap: 1rem;
		margin: 0 0 2.5rem;
		padding: 1rem 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.latest-label time {
		display: block;
		margin-top: 0.5rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.6rem;
	}

	.latest-copy h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.125rem;
		font-weight: 500;
		letter-spacing: -0.025em;
		line-height: 1.25;
	}

	.latest-copy h2 a {
		color: var(--ink);
		text-decoration: none;
	}

	.latest-copy h2 a:hover {
		color: var(--accent);
	}

	.latest-copy > p {
		margin: 0.35rem 0 0;
		color: var(--muted);
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.latest-arrow {
		display: grid;
		width: 1.75rem;
		height: 1.75rem;
		place-items: center;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--ink);
		text-decoration: none;
	}

	.latest-arrow span {
		display: block;
		transition: transform 160ms ease;
	}

	@keyframes arrive {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 440px) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
			gap: 1rem;
		}

		.hero h1 {
			font-size: clamp(2.35rem, 11vw, 3rem);
		}

		.hero-copy > .eyebrow {
			font-size: 0.52rem;
		}

		.primary-link,
		.text-link {
			font-size: 0.68rem;
		}

		.about {
			grid-template-columns: 1fr;
			gap: 0.85rem;
		}
	}

	@media (max-width: 370px) {
		:global(html:root) {
			min-width: 0;
		}

		.hero {
			grid-template-columns: 1fr;
		}

		.portrait {
			width: min(100%, 15rem);
			justify-self: end;
		}
	}

	@media (prefers-color-scheme: dark) {
		.home {
			--paper: #29251f;
			--ink: #f1ece4;
			--muted: #b1a99e;
			--line: #494239;
			--accent: #ed8a6e;
			--accent-deep: #d66b50;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-copy,
		.portrait {
			animation: none;
		}

		.primary-link,
		.text-link,
		.primary-link span,
		.text-link span,
		.latest-arrow span {
			transition: none;
		}
	}
</style>
