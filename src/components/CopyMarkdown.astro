---
interface Props {
	slug: string;
}

const { slug } = Astro.props;
---

<button type="button" class="copy-markdown" data-slug={slug}>
	<svg
		class="copy-icon"
		xmlns="http://www.w3.org/2000/svg"
		width="14"
		height="14"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<rect width="13" height="13" x="9" y="9" rx="2" ry="2"></rect>
		<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
	</svg>
	<span class="copy-label" aria-live="polite">copy post</span>
</button>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-markdown')) {
		const label = button.querySelector<HTMLElement>('.copy-label');
		const slug = button.dataset.slug;

		if (!label || !slug) {
			continue;
		}

		let isCopying = false;

		button.addEventListener('click', async () => {
			if (isCopying) {
				return;
			}

			isCopying = true;

			try {
				const response = await fetch(`/blog/${slug}.md`);

				if (!response.ok) {
					throw new Error(`Request failed: ${response.status}`);
				}

				await navigator.clipboard.writeText(await response.text());
				label.textContent = 'Copied!';
			} catch {
				label.textContent = 'Copy failed';
			}

			setTimeout(() => {
				label.textContent = 'copy post';
				isCopying = false;
			}, 2000);
		});
	}
</script>
