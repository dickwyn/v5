---
import { tagSlug } from '../utils';

interface Props {
	tags: string[];
	activeTag?: string;
}

const { tags, activeTag } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="post-tags">
			{
				tags.map((tag) => {
					const slug = tagSlug(tag);

					return (
						<li>
							<a
								href={`/blog/tags/${slug}`}
								class="post-tag"
								aria-current={activeTag === slug ? 'page' : undefined}
							>
								{tag}
							</a>
						</li>
					);
				})
			}
		</ul>
	)
}
