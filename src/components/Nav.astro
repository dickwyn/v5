---
const navItems = ['blog', 'things'];
---

<aside class="-ml-2 mb-8 text-lg">
	<div class="lg:sticky lg:top-20">
		<nav
			class="relative flex flex-row items-center px-0 pb-0 md:overflow-auto md:relative"
			id="nav"
		>
			<div class="flex flex-row space-x-0 pr-10">
				<a
					href="/"
					class="m-1 flex items-center rounded-md px-2 py-1 transition-all duration-300 hover:bg-(--color-brand-hover) hover:shadow-sm"
				>
					<img
						src="/images/brand/logo-light.svg"
						alt="dickwyn's icon"
						width="54.4"
						height="12"
						class="block dark:hidden"
					/>
					<img
						src="/images/brand/logo-dark.svg"
						alt="dickwyn's icon"
						width="54.4"
						height="12"
						class="hidden dark:block"
					/>
				</a>
				{
					navItems.map((navItem) => (
						<a
							href={`/${navItem}`}
							class="transition-all flex align-middle relative py-1 px-2 m-1"
						>
							{navItem}
						</a>
					))
				}
			</div>
		</nav>
	</div>
</aside>
