---
import type { MarkdownHeading } from '@astrojs/markdown-remark';

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

{
	headings.length > 0 && (
		<nav
			class="sticky top-8 max-h-[calc(100vh-6rem)] overflow-y-auto border-l border-neutral-200 pl-4 text-sm dark:border-neutral-800"
			aria-labelledby="toc-heading"
		>
			<h2
				id="toc-heading"
				class="text-xs font-medium tracking-widest text-neutral-500 uppercase dark:text-neutral-400"
			>
				Table of contents
			</h2>
			<ul class="mt-3 list-none space-y-1.5 p-0">
				{headings.map((heading) => (
					<li class:list={[{ 'pl-4': heading.depth === 3 }]}>
						<a
							href={`#${heading.slug}`}
							class="toc-link block leading-snug text-neutral-600 no-underline hover:text-brand dark:text-neutral-400"
						>
							{heading.text}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

<script>
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));

	if (links.length > 0) {
		const targets = links
			.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
			.filter((el): el is HTMLElement => el !== null);

		const setActive = (id: string | null) => {
			for (const link of links) {
				const isActive = id !== null && decodeURIComponent(link.hash.slice(1)) === id;

				link.classList.toggle('font-medium', isActive);
				link.classList.toggle('text-neutral-900', isActive);
				link.classList.toggle('dark:text-neutral-100', isActive);

				if (isActive) {
					link.setAttribute('aria-current', 'location');
				} else {
					link.removeAttribute('aria-current');
				}
			}
		};

		let frame = 0;

		const update = () => {
			frame = 0;

			let active: HTMLElement | null = null;

			for (const target of targets) {
				if (target.getBoundingClientRect().top <= 80) {
					active = target;
				}
			}

			setActive(active?.id ?? null);
		};

		const schedule = () => {
			frame ||= requestAnimationFrame(update);
		};

		update();
		addEventListener('scroll', schedule, { passive: true });
		addEventListener('resize', schedule, { passive: true });
	}
</script>
